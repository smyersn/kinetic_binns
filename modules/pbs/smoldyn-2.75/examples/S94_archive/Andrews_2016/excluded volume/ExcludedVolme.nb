Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Gaussian", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"gauss", "[", 
    RowBox[{"x_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"sigma", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "*", "Pi"}], "]"}]}], ")"}]}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 

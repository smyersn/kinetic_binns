Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Bounces", " ", "a", " ", "molecule", " ", "starting", " ", "from", " ", 
    "xvect", " ", "for", " ", "a", " ", "unit", " ", "sphere", " ", "about", 
    " ", "origin"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"bounce", "[", "xvect_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "dist", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dist", "=", 
       RowBox[{"Norm", "[", "xvect", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dist", "<", "1"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"(", 
            RowBox[{"1", "-", "dist"}], ")"}]}], ")"}], "*", 
         RowBox[{"xvect", "/", "dist"}]}], ",", "xvect"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.667030309039659*^9, 3.667030520378934*^9}, {
  3.667030660462276*^9, 3.6670306634538927`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Diffuse", " ", "with", " ", "constraint"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"diffusenearsphere", "[", 
    RowBox[{"xvect_", ",", "nsteps_", ",", "steplength_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "pos", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pos", "=", "xvect"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", "nsteps"}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{"pos", "=", 
         RowBox[{"bounce", "[", 
          RowBox[{"pos", "+", 
           RowBox[{"randomvect", "[", "steplength", "]"}]}], "]"}]}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "pos", "]"}], ";"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.667032089725711*^9, 3.667032247383327*^9}, {
  3.667125178263736*^9, 3.667125178559238*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Reflect", " ", "correctly", " ", "off", " ", "of", " ", "a", " ", 
    "sphere"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"reflectoffsphere", "[", 
    RowBox[{"rvect_", ",", "svect_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c", ",", "p", ",", "xvect", ",", "yvect"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"yvect", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", "svect", "]"}], ">=", "1"}], ",", "svect", ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"svect", "-", "rvect"}], ")"}], ".", 
            RowBox[{"(", 
             RowBox[{"svect", "-", "rvect"}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"b", "=", 
           RowBox[{"2", "*", 
            RowBox[{"rvect", ".", 
             RowBox[{"(", 
              RowBox[{"svect", "-", "rvect"}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"c", "=", 
           RowBox[{
            RowBox[{"rvect", ".", "rvect"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"p", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "b"}], "-", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{"b", "^", "2"}], "-", 
                RowBox[{"4", "*", "a", "*", "c"}]}], "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "a"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"xvect", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "p"}], ")"}], "*", "rvect"}], "+", 
            RowBox[{"p", "*", "svect"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"xvect", "+", 
           RowBox[{"(", 
            RowBox[{"svect", "-", "xvect"}], ")"}], "-", 
           RowBox[{"2", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"svect", "-", "xvect"}], ")"}], ".", "xvect"}], "*", 
            "xvect"}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "yvect", "]"}], ";"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.667070107965892*^9, 3.667070198038087*^9}, {
